# Copier ce fichier en .env et ajuster les valeurs.
# En production (Vercel), définir ces variables dans
# Settings > Environment Variables du projet.

SECRET_KEY=change-moi
FLASK_DEBUG=0
PORT=8000

# --- Base de données MySQL (obligatoire) -----------------------------
# Soit une URL complète :
DATABASE_URL=mysql://user:password@host:3306/kent
# ... soit les variables séparées (utilisées si DATABASE_URL est absente) :
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=
# MYSQL_DATABASE=kent
# SSL : par défaut activé sauf si l'hôte est localhost. Forcer avec :
# MYSQL_SSL=1   (ou 0 pour désactiver)

# --- Génération PDF -------------------------------------------------
# wkhtmltopdf : binaire système local (développement)
# http        : fonction serverless Node /api/render_pdf (Vercel)
PDF_ENGINE=wkhtmltopdf
WKHTMLTOPDF_BIN=wkhtmltopdf
# Base URL du service de rendu si PDF_ENGINE=http et qu'on ne veut pas
# utiliser VERCEL_URL (auto). Laisser vide sur Vercel.
PDF_RENDER_URL=
# Secret partagé entre l'app et la fonction Node (recommandé en prod).
PDF_RENDER_SECRET=

# --- Pièces jointes -------------------------------------------------
# Taille max d'un fichier joint (Mo). Doit rester <= max_allowed_packet
# du serveur MySQL.
MAX_UPLOAD_MB=8

# --- Initialisation de la base -------------------------------------
# Secret pour la route GET /admin/init?key=... (crée le schéma + les
# templates par défaut sans accès MySQL depuis votre poste). Laisser vide
# désactive la route (404).
SEED_SECRET=

# --- Coordonnées affichées sur l'OM et le BC ------------------------
COMPANY_NAME=Transports KENT
COMPANY_ADDRESS=14 Rue du Fer à Cheval
COMPANY_POSTAL_CODE=28200
COMPANY_CITY=ST-DENIS-LANNERAY
COMPANY_PHONE=07 44 90 60 38
COMPANY_SIRET=93073109600010
OM_LEGAL_REF=28/11/2011 Art1-1er-2
BC_LEGAL_REF=28/12/2011

# --- Email ---------------------------------------------------------
# "basic" (SMTP classique) ou "oauth2_o365" (Microsoft 365 / Exchange Online)
SMTP_AUTH_METHOD=basic
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre-adresse@gmail.com
SMTP_PASS=mot-de-passe-application
SMTP_FROM_NAME=Transports KENT
SMTP_FROM_EMAIL=votre-adresse@gmail.com

# Mode "oauth2_o365" (voir requirements-optional.txt) :
O365_TENANT_ID=
O365_CLIENT_ID=
O365_CLIENT_SECRET=
O365_SENDER_EMAIL=
